;; ===========================================================================
;; tron-grid-dots — eww HUD dashboard (~50-60 MB daemon RSS — the heaviest
;; single piece of this stack; everything else stays under ~30 MB).
;; Toggled by Super+D via scripts/hud-toggle.sh (slide-in via revealer).
;; ===========================================================================

;; --- state -----------------------------------------------------------------
(defvar hud-visible false)

;; --- data sources ----------------------------------------------------------
(defpoll time    :interval "10s" :initial "--:--" "date '+%H:%M'")
(defpoll date    :interval "60s" :initial "..."   "date '+%A  //  %d.%m.%Y'")
(defpoll weather :interval "900s"
                 :initial '{"temp":"--","desc":"SCANNING","icon":"󰖙"}'
                 "scripts/weather.sh")
(defpoll fetch   :interval "30s"
                 :initial '{"user":"user","host":"grid","wm":"bspwm","uptime":"--","battery":"--","distro":"Lubuntu"}'
                 "scripts/fetch.sh")
(defpoll disk    :interval "60s" :initial "0" "scripts/disk.sh")
(deflisten music :initial '{"status":"none","title":"NO SIGNAL","artist":"--"}'
                 "scripts/music.sh")
(defpoll ext-screen :interval "4s" :initial "none" "scripts/display-status.sh")

;; --- widgets ---------------------------------------------------------------
(defwidget card [title]
  (box :class "card" :orientation "v" :space-evenly false
    (label :class "card-title" :halign "start" :text title)
    (children)))

(defwidget clock-card []
  (card :title "CHRONO"
    (label :class "clock" :text time)
    (label :class "date"  :text date)))

(defwidget weather-card []
  (card :title "ATMOSPHERE"
    (box :space-evenly false :spacing 12
      (label :class "weather-icon" :text {weather.icon})
      (box :orientation "v" :space-evenly false :valign "center"
        (label :class "weather-temp" :halign "start" :text {weather.temp})
        (label :class "weather-desc" :halign "start" :text {weather.desc})))))

(defwidget fetch-row [k v]
  (box :class "fetch-row" :space-evenly false
    (label :class "fetch-key" :text k)
    (label :class "fetch-val" :limit-width 24 :text v)))

(defwidget fetch-card []
  (card :title "IDENTITY DISC"
    (fetch-row :k "USER"   :v "${fetch.user}@${fetch.host}")
    (fetch-row :k "SYSTEM" :v {fetch.distro})
    (fetch-row :k "WM"     :v {fetch.wm})
    (fetch-row :k "UPTIME" :v {fetch.uptime})
    (fetch-row :k "POWER"  :v {fetch.battery})))

(defwidget music-card []
  (card :title "AUDIO STREAM"
    (label :class "music-title"  :limit-width 28 :halign "start"
           :text {music.title})
    (label :class "music-artist" :limit-width 28 :halign "start"
           :text {music.artist})
    (box :class "music-controls" :halign "center" :spacing 24 :space-evenly false
      ;; Nerd Fonts v3 (nf-md-*) codepoints — v2 ones render as CJK tofu
      (button :onclick "playerctl previous" "󰒮")
      (button :class "play" :onclick "playerctl play-pause"
              {music.status == "Playing" ? "󰏤" : "󰐊"})
      (button :onclick "playerctl next" "󰒭"))))

;; one-tap app launcher (tablet-friendly); edit the list to taste
(defwidget app-btn [icon cmd]
  (button :class "app-btn" :onclick "setsid -f ${cmd} >/dev/null 2>&1" icon))

(defwidget launch-card []
  (card :title "PROGRAMS"
    (box :orientation "v" :spacing 6 :space-evenly false
      (box :spacing 6 :space-evenly true
        (app-btn :icon "󰆍" :cmd "kitty")            ;; terminal
        (app-btn :icon "󰈹" :cmd "firefox")          ;; browser
        (app-btn :icon "󰉋" :cmd "pcmanfm-qt")       ;; files (GUI)
        (app-btn :icon "󰝚" :cmd "kitty -e cmus"))   ;; music
      (box :spacing 6 :space-evenly true
        (app-btn :icon "󰍛" :cmd "kitty -e btop")    ;; system monitor
        (app-btn :icon "󰑵" :cmd "tron-rotate")      ;; rotate panel
        (app-btn :icon {ext-screen == "mirror" ? "󰍹" : "󰶐"}
                 :cmd "tron-display toggle")))))    ;; second screen on/off (mirror)

;; entertainment: wide labeled buttons (couch/touch targets)
(defwidget media-btn [icon label cmd]
  (button :class "media-btn" :onclick "setsid -f ${cmd} >/dev/null 2>&1"
    (box :space-evenly false :spacing 8 :halign "center"
      (label :text icon)
      (label :class "media-label" :text label))))

(defwidget media-card []
  (card :title "ENTERTAINMENT"
    (box :spacing 6 :space-evenly true
      (media-btn :icon "󰊴" :label "GAMES"   :cmd "es-de")
      (media-btn :icon "󰎁" :label "THEATER" :cmd "kodi"))))

(defwidget ring [value label]
  (box :orientation "v" :space-evenly false
    ;; explicit size — without it GTK collapses the ring to ~24px
    (circular-progress :class "ring" :value value :thickness 5 :start-at 75
                       :width 64 :height 64
      (label :class "ring-value" :text "${round(value, 0)}"))
    (label :class "ring-label" :text label)))

(defwidget rings-card []
  (card :title "CORE LOAD"
    (box :halign "center" :spacing 18 :space-evenly false
      (ring :value {EWW_CPU.avg} :label "CPU")
      (ring :value {EWW_RAM.used_mem_perc} :label "RAM")
      (ring :value disk :label "DISK"))))

;; power row: logout works under bspwm and openbox; reboot/poweroff go
;; through logind (no sudo needed for an active local session)
(defwidget power-btn [icon label cmd ?danger]
  (button :class {(danger ?: false) ? "power-btn power-danger" : "power-btn"}
          :onclick "setsid -f sh -c '${cmd}' >/dev/null 2>&1"
    (box :space-evenly false :spacing 8 :halign "center"
      (label :text icon)
      (label :class "media-label" :text label))))

(defwidget power-card []
  (box :class "power-row" :spacing 6 :space-evenly true
    (power-btn :icon "󰗽" :label "LOGOUT"
               :cmd "bspc quit 2>/dev/null || openbox --exit")
    (power-btn :icon "󰜉" :label "REBOOT" :cmd "systemctl reboot")
    (power-btn :icon "󰐥" :label "SHUTDOWN" :cmd "systemctl poweroff"
               :danger true)))

;; --- window ----------------------------------------------------------------
;; two-column card grid; no :height, so the window wraps its content
(defwindow hud
  :monitor 0
  :geometry (geometry :x "10px" :y "10px" :width "560px" :anchor "top right")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  (revealer :reveal hud-visible :transition "slideleft" :duration "250ms"
    (box :class "hud" :orientation "v" :space-evenly false :spacing 10
      (label :class "hud-header" :text "// SYSTEM MONITOR //")
      (box :orientation "h" :space-evenly true :spacing 10
        (box :orientation "v" :space-evenly false :spacing 10
          (clock-card)
          (rings-card)
          (fetch-card))
        (box :orientation "v" :space-evenly false :spacing 10
          (launch-card)
          (media-card)
          (weather-card)
          (music-card)))
      (power-card))))

;; MagicMirror-style idle overlay. Tap anywhere to resume — no X locker.
(defwindow mirror
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%")
  :stacking "overlay"
  :windowtype "normal"
  :wm-ignore true
  :exclusive false
  :focusable true
  (button :class "mirror" :onclick "scripts/mirror-toggle.sh hide"
    (box :class "mirror-inner" :orientation "v" :halign "center" :valign "center"
         :spacing 14 :space-evenly false
      (label :class "mirror-tag" :text "// GRID IDLE //")
      (label :class "mirror-clock" :text time)
      (label :class "mirror-date" :text date)
      (box :class "mirror-rule")
      (box :spacing 18 :halign "center" :space-evenly false
        (label :class "mirror-wicon" :text {weather.icon})
        (label :class "mirror-wtemp" :text {weather.temp}))
      (label :class "mirror-wdesc" :text {weather.desc})
      (label :class "mirror-hint" :text "TAP ANYWHERE TO RESUME"))))
