;; GENERATED by scripts/skin-render.sh from tron.json — do not edit
;; interval hint for slideshow.sh: 20
(defwindow mirror
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%")
  :stacking "overlay"
  :windowtype "normal"
  :wm-ignore true
  (button :class "mirror style-tron bg-dim" :onclick "scripts/mirror-toggle.sh hide"
    (box :class "mirror-root" :orientation "v" :hexpand true :vexpand true
         :style {slideshow == "" ? "" : "background-image: url('${slideshow}'); background-size: cover; background-position: center;"}
      (box :class "mirror-dim" :hexpand true :vexpand true :orientation "v" :space-evenly true
           :style "background-color: rgba(5, 8, 13, 0.92);"
        (box :class "mirror-row top" :hexpand true :space-evenly true :valign "start"
          (box :class "slot slot-top-left" :halign "start" :valign "start" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
          (box :class "slot slot-top-center" :halign "center" :valign "start" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
          (box :class "slot slot-top-right" :halign "end" :valign "start" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
        )
        (box :class "mirror-row mid" :hexpand true :vexpand true :space-evenly true :valign "center"
          (box :class "slot slot-center-left" :halign "start" :valign "center" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
          (box :class "slot slot-center" :halign "center" :valign "center" :hexpand true :orientation "v" :space-evenly false :spacing 8
            (label :class "mirror-tag" :text "// GRID IDLE //")
            (label :class "mirror-clock" :text time)
            (label :class "mirror-date" :text date)
            (box :class "mirror-weather" :spacing 10 :space-evenly false :halign "center"
              (label :class "mirror-wicon" :text {weather.icon})
              (box :orientation "v" :space-evenly false
                (label :class "mirror-wtemp" :halign "start" :text {weather.temp})
                (label :class "mirror-wdesc" :halign "start" :text {weather.desc})))
          )
          (box :class "slot slot-center-right" :halign "end" :valign "center" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
        )
        (box :class "mirror-row bot" :hexpand true :space-evenly true :valign "end"
          (box :class "slot slot-bottom-left" :halign "start" :valign "end" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
          (box :class "slot slot-bottom-center" :halign "center" :valign "end" :hexpand true :orientation "v" :space-evenly false :spacing 8
            (label :class "mirror-hint" :text "TAP ANYWHERE TO RESUME")
          )
          (box :class "slot slot-bottom-right" :halign "end" :valign "end" :hexpand true :orientation "v" :space-evenly false :spacing 8
          )
        )
      ))))
