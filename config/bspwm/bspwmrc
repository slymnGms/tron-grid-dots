#!/usr/bin/env bash
# ============================================================================
# tron-grid-dots — bspwm (~2 MB RSS). Thin accent borders, small gaps.
# This file is a symlink into the repo, so we can locate the repo through it.
# ============================================================================

REPO="$(dirname "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")")"
# shellcheck source=../../theme/palette.sh
. "$REPO/theme/palette.sh"

# D330: panel is 90° off. Boot already rotates fbcon; X starts unrotated, so
# apply --rotate right here only if login/Xsetup did not.
"$REPO/scripts/rotate.sh" --quiet --ensure || true
pgrep -f 'display.sh watch|tron-display watch' >/dev/null || \
    "$REPO/scripts/display.sh" watch &

# --- desktops / layout -------------------------------------------------------
bspc monitor -d 1 2 3 4 5 6

bspc config border_width          2
bspc config window_gap            8
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config focus_follows_pointer true
bspc config pointer_modifier      mod4

# --- colors from the palette (recolor = edit ACCENT, nothing else) -----------
bspc config normal_border_color   "$TRON_FG_DIM"
bspc config focused_border_color  "$TRON_ACCENT"
bspc config active_border_color   "$TRON_ACCENT_SOFT"
bspc config urgent_border_color   "$TRON_WARN"
bspc config presel_feedback_color "$TRON_ACCENT_SOFT"

# --- rules -------------------------------------------------------------------
bspc rule -r '*'
bspc rule -a Eww state=floating border=off
bspc rule -a Rofi state=floating
# entertainment apps: borderless fullscreen couch mode (both class casings)
for c in Kodi kodi ES-DE es-de RetroArch retroarch; do
    bspc rule -a "$c" state=fullscreen border=off
done

# --- autostart (only once, survives bspwm restarts) --------------------------
pgrep -x sxhkd  >/dev/null || sxhkd &

# picom (~30 MB): config is static; the accent shadow color is injected here
# from the palette so picom.conf never needs regenerating.
# SKIPPED inside VMs: compositing + vsync on an emulated GPU causes
# seconds-long input lag. Override with TRON_FORCE_PICOM=1 if your VM has
# working 3D acceleration.
if ! pgrep -x picom >/dev/null; then
    if [ -z "${TRON_FORCE_PICOM:-}" ] && systemd-detect-virt --vm --quiet 2>/dev/null; then
        : # VM: no compositor (no shadows/rounding/opacity, but instant input)
    else
        read -r SR SG SB <<< "$(hex_to_rgb_frac "$TRON_ACCENT")"
        picom --config "$HOME/.config/picom/picom.conf" \
              --shadow-red "$SR" --shadow-green "$SG" --shadow-blue "$SB" &
    fi
fi

# wallpaper
WALL="$REPO/theme/wallpapers/tron-grid.png"
[ -f "$WALL" ] && feh --no-fehbg --bg-fill "$WALL"

pgrep -x dunst  >/dev/null || dunst &

"$HOME/.config/polybar/launch.sh" &

# eww daemon (~50-60 MB idle — the single heaviest piece of the shell;
# comment this out and Super+D will start it on demand instead)
# eww: generate palette if missing, then start the daemon and reload styles
if [ ! -f "$REPO/config/eww/_generated.scss" ]; then
    bash "$REPO/theme/apply.sh" >/dev/null 2>&1 || true
fi
command -v eww >/dev/null && { eww daemon >/dev/null 2>&1 & }

# Stock screensaver/DPMS blanks the rotated panel with no dismiss UI.
# xset actually turns blanking off (the old comment never did); idle-mirror
# then shows a tap-to-resume clock/weather overlay.
command -v xset >/dev/null && xset s off s noblank -dpms
pgrep -f 'idle-mirror.sh' >/dev/null || "$REPO/scripts/idle-mirror.sh" &

# X cursor
xsetroot -cursor_name left_ptr
