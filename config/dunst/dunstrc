# ============================================================================
# tron-grid-dots — dunst (~3-5 MB RSS).
# Colors live in dunstrc.d/50-colors.gen.conf (generated by theme/apply.sh);
# dunst merges dunstrc.d/*.conf automatically.
# ============================================================================
[global]
    monitor = 0
    follow = none
    origin = top-right
    offset = (12, 42)
    width = 320
    height = (0, 200)
    gap_size = 6

    frame_width = 1
    corner_radius = 8
    separator_height = 1
    padding = 10
    horizontal_padding = 12

    font = JetBrainsMono Nerd Font 9
    format = "<b>%s</b>\n%b"
    alignment = left
    markup = full
    show_indicators = false
    icon_position = off

    sort = yes
    stack_duplicates = true
    idle_threshold = 120
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    timeout = 0
