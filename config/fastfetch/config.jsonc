// ===========================================================================
// tron-grid-dots — fastfetch, bordered-box layout.
// No include support in jsonc, so theme/apply.sh renders a copy of this to
// ~/.config/fastfetch/ swapping the "0;229;255" / "255;74;28" RGB triplets
// when ACCENT=orange. Edit here, then re-run theme/apply.sh.
// ===========================================================================
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;0;229;255" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;0;229;255", "title": "38;2;0;229;255" },
        "key": { "width": 12 }
    },
    "modules": [
        { "type": "custom", "format": "[38;2;0;229;255m╭──────────── SYSTEM ─────────────╮" },
        { "type": "title", "key": "  user", "format": "{user-name}@{host-name}" },
        { "type": "os", "key": "  distro", "format": "{name} {version}" },
        { "type": "kernel", "key": "  kernel" },
        { "type": "wm", "key": "  wm" },
        { "type": "shell", "key": "  shell" },
        { "type": "terminal", "key": "  term" },
        { "type": "custom", "format": "[38;2;0;229;255m├──────────── STATUS ─────────────┤" },
        { "type": "uptime", "key": "  uptime" },
        { "type": "packages", "key": "  pkgs" },
        { "type": "memory", "key": "  memory" },
        { "type": "disk", "key": "  disk", "folders": "/" },
        { "type": "battery", "key": "  battery" },
        { "type": "custom", "format": "[38;2;0;229;255m╰─────────────────────────────────╯" },
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
