# ============================================================================
# tron-grid-dots — openbox theme (cyan-default template).
# theme/apply.sh renders this (accent-swapped) to
# ~/.themes/TronGrid/openbox-3/themerc — openbox can't read it from ~/.config.
# ============================================================================

border.width: 1
padding.width: 6
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
menu.overlap.x: 0

# --- titlebar ---
window.active.title.bg: flat solid
window.active.title.bg.color: #0A1017
window.active.label.text.color: #00E5FF
window.active.border.color: #00E5FF
window.active.button.unpressed.image.color: #C8D6E0
window.active.button.pressed.image.color: #00E5FF
window.active.button.hover.image.color: #00E5FF

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #05080D
window.inactive.label.text.color: #4A6070
window.inactive.border.color: #4A6070
window.inactive.button.unpressed.image.color: #4A6070

window.label.text.justify: center

# --- menu ---
menu.border.color: #00E5FF
menu.border.width: 1
menu.title.bg: flat solid
menu.title.bg.color: #0A1017
menu.title.text.color: #00E5FF
menu.items.bg: flat solid
menu.items.bg.color: #05080D
menu.items.text.color: #C8D6E0
menu.items.disabled.text.color: #4A6070
menu.items.active.bg: flat solid
menu.items.active.bg.color: #0A1017
menu.items.active.text.color: #00E5FF

# --- osd (alt-tab etc) ---
osd.border.color: #00E5FF
osd.border.width: 1
osd.bg: flat solid
osd.bg.color: #05080D
osd.label.text.color: #C8D6E0
osd.hilight.bg: flat solid
osd.hilight.bg.color: #00E5FF
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0A1017
