# tron-grid-dots — openbox autostart (sourced by openbox-session as sh).
# Mirrors the bspwmrc autostart, minus bspwm-specific bits.

REPO="$(dirname "$(dirname "$(dirname "$(readlink -f "$HOME/.config/openbox/autostart")")")")"
. "$REPO/theme/palette.sh"

# D330: panel is 90° off. Apply --rotate right only if login did not.
"$REPO/scripts/rotate.sh" --quiet --ensure || true
pgrep -f 'display.sh watch|tron-display watch' >/dev/null || \
    "$REPO/scripts/display.sh" watch &

# compositor skipped inside VMs — see the note in bspwmrc
if ! pgrep -x picom >/dev/null; then
    if [ -n "${TRON_FORCE_PICOM:-}" ] || ! systemd-detect-virt --vm --quiet 2>/dev/null; then
        set -- $(hex_to_rgb_frac "$TRON_ACCENT")
        picom --config "$HOME/.config/picom/picom.conf" \
              --shadow-red "$1" --shadow-green "$2" --shadow-blue "$3" &
    fi
fi

[ -f "$REPO/theme/wallpapers/tron-grid.png" ] && \
    feh --no-fehbg --bg-fill "$REPO/theme/wallpapers/tron-grid.png"

pgrep -x dunst >/dev/null || dunst &
"$HOME/.config/polybar/launch.sh" &
command -v eww >/dev/null && { eww daemon >/dev/null 2>&1 & }

# Stock screensaver blanks the rotated panel with no dismiss UI — see bspwmrc.
command -v xset >/dev/null && xset s off s noblank -dpms
pgrep -f 'idle-mirror.sh' >/dev/null || "$REPO/scripts/idle-mirror.sh" &

# touch-friendly: on-screen keyboard daemon if installed (apt: onboard)
command -v onboard >/dev/null && onboard --startup-delay=3 &
