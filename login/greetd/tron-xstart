#!/bin/sh
# ============================================================================
# tron-grid-dots — X session wrapper used by tuigreet.
# Same as tuigreet's default ("startx /usr/bin/env <session>") but logs the
# whole session to ~/.local/state/tron/xsession.log, because a session that
# dies under greetd otherwise vanishes without a trace when the VT switches.
# Installed to /usr/local/bin/tron-xstart by install.sh.
# ============================================================================
LOG_DIR="$HOME/.local/state/tron"
mkdir -p "$LOG_DIR"
echo "=== tron-xstart $(date '+%F %T') session: $* ===" >> "$LOG_DIR/xsession.log"
exec startx /usr/bin/env "$@" >> "$LOG_DIR/xsession.log" 2>&1
